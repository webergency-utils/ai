{
    "name": "@webergency-utils/ai",
    "version": "0.1.0",
    "description": "High-performance developer-first AI toolkit with multimodal support, dynamic provider imports, abstract storage, spend calculation, MCP, and agentic workflows",
    "keywords": [
        "ai",
        "llm",
        "openai",
        "anthropic",
        "gemini",
        "ollama",
        "mcp",
        "agent",
        "workflow",
        "embeddings",
        "vector-store",
        "typescript",
        "esm"
    ],
    "author": "radixxko",
    "license": "MIT",
    "homepage": "https://github.com/webergency-utils/ai#readme",
    "bugs": {
        "url": "https://github.com/webergency-utils/ai/issues"
    },
    "type": "module",
    "sideEffects": false,
    "engines": {
        "node": ">=20.3.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/webergency-utils/ai.git"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./core": {
            "types": "./dist/core/index.d.ts",
            "import": "./dist/core/index.js"
        },
        "./providers": {
            "types": "./dist/providers/index.d.ts",
            "import": "./dist/providers/index.js"
        },
        "./storage": {
            "types": "./dist/storage/index.d.ts",
            "import": "./dist/storage/index.js"
        },
        "./mcp": {
            "types": "./dist/mcp/index.d.ts",
            "import": "./dist/mcp/index.js"
        },
        "./spend": {
            "types": "./dist/spend/index.d.ts",
            "import": "./dist/spend/index.js"
        },
        "./agent": {
            "types": "./dist/agent/index.d.ts",
            "import": "./dist/agent/index.js"
        },
        "./workflow": {
            "types": "./dist/workflow/index.d.ts",
            "import": "./dist/workflow/index.js"
        },
        "./trace": {
            "types": "./dist/trace/index.d.ts",
            "import": "./dist/trace/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/**/*",
        "src/**/*",
        "README.md",
        "LICENSE",
        "SECURITY.md",
        "CHANGELOG.md"
    ],
    "scripts": {
        "build": "tsc",
        "clean": "rm -rf ./dist",
        "prepack": "npm run clean && npm run build",
        "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
        "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
        "lint:package": "publint --strict && attw --pack . --profile esm-only",
        "typecheck": "tsc -p tsconfig.test.json --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:live": "vitest run --config vitest.live.config.ts",
        "record:fixtures": "node scripts/record-fixtures.mjs",
        "check:pack": "node scripts/check-pack.mjs",
        "smoke:pack": "node scripts/smoke-pack.mjs",
        "check:readme": "node scripts/check-readme.mjs",
        "check:skips": "node scripts/check-skips.mjs",
        "gen:capabilities": "node scripts/gen-capability-table.mjs",
        "release:check": "node scripts/release-check.mjs",
        "fuzz": "npm run build && node scripts/run-fuzz.mjs fuzz_stream.cjs -- -runs=1000 -max_total_time=60",
        "fuzz:legacy": "npm run build && node scripts/run-fuzz.mjs fuzz_ai.cjs -- -runs=1000 -max_total_time=60"
    },
    "dependencies": {
        "@webergency-utils/typechecker": "^0.8.1"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@eslint/js": "^10.0.1",
        "@jazzer.js/core": "^2.1.0",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "^24.0.10",
        "@vitest/coverage-v8": "^3.2.7",
        "eslint": "^10.2.0",
        "publint": "^0.3.25",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.58.1",
        "vitest": "^3.1.4"
    },
    "peerDependencies": {
        "@anthropic-ai/sdk": ">=0.30.0",
        "@google/genai": ">=0.1.0",
        "ollama": ">=0.5.0",
        "openai": ">=4.0.0"
    },
    "peerDependenciesMeta": {
        "@anthropic-ai/sdk": {
            "optional": true
        },
        "@google/genai": {
            "optional": true
        },
        "openai": {
            "optional": true
        },
        "ollama": {
            "optional": true
        }
    }
}
