{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        "rootDir": ".",
        "declaration": false,
        "declarationMap": false,
        "sourceMap": false,
        "types": [ "node", "vitest/globals" ]
    },
    "include": [
        "src/**/*",
        "tests/**/*",
        "scripts/**/*.d.mts",
        "vitest.config.ts",
        "vitest.live.config.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}
